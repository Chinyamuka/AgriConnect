# ============================================
# PYTHON
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
venv/
env/
ENV/
.venv/
.venv2/
envs/
.env

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Logs
logs/
*.log
*.log.*

# Database
*.db
*.sqlite
*.sqlite3
*.db.sqlite3

# ============================================
# DJANGO
# ============================================

# Django migrations (except init)
*/migrations/*.py
!*/migrations/__init__.py

# Django media and static
media/
staticfiles/
*.media
*.static

# Django local settings
local_settings.py
settings_local.py
settings/production.py

# ============================================
# ENVIRONMENT VARIABLES
# ============================================

# Env files with secrets - NEVER COMMIT!
.env
.env.local
.env.production
.env.staging
.env.dev
.env.test
.env.example

